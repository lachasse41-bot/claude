# ---------------------------------------------------------------------------
# Configuration du serveur. Copier ce fichier en `.env` et adapter les valeurs.
# Ne jamais committer le fichier `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Secret maitre : signature des sessions, chiffrement des cles API, URL signees.
# OBLIGATOIRE en production, minimum 32 caracteres.
# Generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# URL publique de l'API. DOIT etre joignable depuis Internet : KIE.ai telecharge
# les images de reference via des URL signees et appelle le webhook de callback.
# En local, utiliser un tunnel (ex: cloudflared, ngrok).
PUBLIC_BASE_URL=http://localhost:4000

# Origine(s) du frontend autorisee(s) (separees par des virgules).
WEB_ORIGIN=http://localhost:5173

# --- Fournisseur de modeles IA (KIE.ai) ------------------------------------
# La cle peut aussi etre saisie depuis Administration > Parametres : elle est
# alors chiffree en base et prend le pas sur cette variable.
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_REQUEST_TIMEOUT_MS=30000

# --- Envoi des e-mails (invitations, mot de passe oublie) ------------------
# Optionnel : sans configuration, les liens restent generes et valides mais
# doivent etre transmis manuellement. Ces valeurs servent de repli ; une
# configuration saisie depuis Administration > Parametres est prioritaire.
SMTP_HOST=
SMTP_PORT=587
# true pour un TLS implicite (port 465), false pour STARTTLS (port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Nova Studio
MAIL_REPLY_TO=
MAIL_TIMEOUT_MS=15000

# --- Stockage --------------------------------------------------------------
DATA_DIR=./data
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25
# Recopie les fichiers produits par le provider vers le stockage local afin que
# la galerie reste consultable apres expiration des URL distantes.
MIRROR_OUTPUTS=true

# --- Sessions --------------------------------------------------------------
SESSION_TTL_DAYS=7
# Mettre a true derriere HTTPS (obligatoire en production).
COOKIE_SECURE=false

# --- Worker de suivi des generations ---------------------------------------
POLL_INTERVAL_MS=5000
POLL_BATCH_SIZE=20
WORKER_ENABLED=true

# --- Compte administrateur cree au premier demarrage -----------------------
BOOTSTRAP_ORG_NAME=Mon organisation
BOOTSTRAP_ADMIN_EMAIL=admin@nova.studio
BOOTSTRAP_ADMIN_NAME=Administrateur
# Laisser vide pour qu'un mot de passe aleatoire soit genere et affiche une
# seule fois dans la console au premier demarrage.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Deploiement mono-processus --------------------------------------------
# true => l'API sert aussi le frontend compile (apps/web/dist).
SERVE_WEB=false
